#!/usr/bin/python3
"""Configure the physical layout and the existing Japanese/Chinese/Korean engines."""
import configparser
import io
import json
import os
from pathlib import Path
import tempfile


def boot_options(cmdline):
    words = dict(word.split('=', 1) for word in cmdline.split() if '=' in word)
    layout = words.get('steamac.keyboard')
    return (layout if layout in ('us', 'jis', 'iso') else None,
            words.get('steamac.japanese_ime') == '1')


def environment(layout, japanese):
    values = {}
    if layout:
        values.update(XKB_DEFAULT_LAYOUT='jp' if layout == 'jis' else 'us',
                      XKB_DEFAULT_MODEL='pc105', XKB_DEFAULT_VARIANT='', XKB_DEFAULT_OPTIONS='')
    if japanese:
        values.update(XMODIFIERS='@im=ibus', GTK_IM_MODULE='xim', QT_IM_MODULE='xim',
                      SDL_IM_MODULE='ibus', GLFW_IM_MODULE='ibus')
    return values


def anthy_shortcuts(current):
    result = {k: list(v) for k, v in current.items()}
    # Keep Anthy active in direct/Latin mode for gameplay. Switching mode happens inside
    # Anthy, so JIS Kana/Eisu select a mode rather than cycling unrelated engines.
    result['on_off'] = list(dict.fromkeys([*result.get('on_off', []), 'Ctrl+space']))
    result['latin_mode'] = ['Muhenkan']
    result['hiragana_mode'] = ['Hiragana']
    result['convert_to_char_type_forward'] = [k for k in result.get('convert_to_char_type_forward', [])
                                             if k != 'Muhenkan']
    return result


def preferred_engine(cmdline):
    words = dict(word.split('=', 1) for word in cmdline.split() if '=' in word)
    base = 'xkb:jp::jpn' if words.get('steamac.keyboard') == 'jis' else 'xkb:us::eng'
    return {'ja': 'anthy', 'ko': 'hangul', 'zh-Hans': 'pinyin'}.get(words.get('steamac.input_language'), base)


def engine_order(current, layout, preferred, fresh):
    base = 'xkb:jp::jpn' if layout == 'jis' else 'xkb:us::eng'
    added = [preferred, base, 'anthy', 'pinyin', 'hangul']
    return list(dict.fromkeys(added + current if fresh else current + added))


def configure_cjk(layout, preferred, runtime, fresh):
    """One migration adds engines; subsequent starts retain edits and the selected engine."""
    marker = Path.home()/'.config/steamac/cjk-input-v1.json'
    if marker.exists():
        return
    for component in ('pinyin.xml', 'hangul.xml'):
        if not (Path('/usr/share/ibus/component')/component).is_file():
            raise RuntimeError('SteamOS input component missing: '+component)
    import gi
    gi.require_version('Gio', '2.0')
    from gi.repository import Gio, GLib
    general = Gio.Settings.new('org.freedesktop.ibus.general')
    hotkey = Gio.Settings.new('org.freedesktop.ibus.general.hotkey')
    hangul = Gio.Settings.new('org.freedesktop.ibus.engine.hangul')
    previous = {}

    def save(settings, key, value, only_unset=False):
        if only_unset and settings.get_user_value(key) is not None:
            return
        previous[settings.props.schema_id+'/'+key] = settings.get_value(key).print_(True)
        if not settings.set_value(key, value):
            raise RuntimeError('Could not save '+key)

    for key in ('preload-engines', 'engines-order'):
        save(general, key, GLib.Variant('as', engine_order(list(general.get_strv(key)), layout, preferred, fresh)))
    # This opens IBus's engine switcher without taking Anthy's Control+Space shortcut.
    save(hotkey, 'triggers', GLib.Variant('as', list(dict.fromkeys([
        *hotkey.get_strv('triggers'), '<Control>period']))))
    for key, value in [('hangul-keyboard', '2'), ('initial-input-mode', 'latin'),
                       ('switch-keys', 'Hangul,Control+space')]:
        save(hangul, key, GLib.Variant('s', value), only_unset=True)
    Gio.Settings.sync()
    atomic_write(marker, json.dumps({'version': 1, 'previous': previous,
                                    'pinyin_pending': True}, indent=2)+'\n')
    if fresh:
        atomic_write(runtime/'activate-engine', preferred+'\n')
        (runtime/'activate-anthy').unlink(missing_ok=True)


def desktop_layout(text, layout, previous=None):
    """KWin's nested Wayland seat has its own layout; keep an observed user override."""
    config = configparser.ConfigParser(interpolation=None, strict=False)
    config.optionxform = str
    config.read_string(text)
    current = dict(config['Layout']) if config.has_section('Layout') else {}
    if previous is not None and any(current.get(k) != v for k, v in previous.items()):
        return text, None
    want = {'Use': 'true', 'Model': 'pc105', 'LayoutList': 'jp' if layout == 'jis' else 'us',
            'VariantList': '', 'Options': '', 'ResetOldOptions': 'true'}
    if not config.has_section('Layout'):
        config.add_section('Layout')
    config['Layout'].update(want)
    out = io.StringIO()
    config.write(out, space_around_delimiters=False)
    return out.getvalue(), want


def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name+'.', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(text)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def main():
    cmdline = Path('/proc/cmdline').read_text()
    layout, japanese = boot_options(cmdline)
    runtime = Path(os.environ['XDG_RUNTIME_DIR'])/'steamac'
    values = environment(layout, japanese)
    atomic_write(runtime/'input.env', ''.join(f'{k}={v}\n' for k, v in values.items()))
    # Desktop Mode's live sync owns kxkbrc when enabled. IBus and the outer
    # Gamescope layout below still follow the physical geometry / selected IME.
    follow_mac = 'steamac.follow_mac_keyboard=1' in cmdline.split()
    if layout and not follow_mac:
        state_path = Path.home()/'.config/steamac/keyboard-layout-v1.json'
        state = json.loads(state_path.read_text()) if state_path.exists() else {}
        desktop = Path.home()/'.config/kxkbrc'
        if not state.get('user_override'):
            text = desktop.read_text() if desktop.exists() else ''
            updated, managed = desktop_layout(text, layout, state.get('managed'))
            if managed is not None:
                atomic_write(desktop, updated)
                state = {'managed': managed}
            else:
                state['user_override'] = True
            atomic_write(state_path, json.dumps(state, indent=2)+'\n')
    if not japanese:
        return
    if not Path('/usr/share/ibus/component/anthy.xml').is_file():
        raise RuntimeError('This SteamOS image does not include ibus-anthy; Japanese IME unavailable')
    marker = Path.home()/'.config/steamac/japanese-input-v1.json'
    fresh = not marker.exists()
    if fresh:
        import gi
        gi.require_version('Gio', '2.0')
        from gi.repository import Gio, GLib
        general = Gio.Settings.new('org.freedesktop.ibus.general')
        hotkey = Gio.Settings.new('org.freedesktop.ibus.general.hotkey')
        common = Gio.Settings.new('org.freedesktop.ibus.engine.anthy.common')
        shortcut = Gio.Settings.new('org.freedesktop.ibus.engine.anthy.shortcut')
        base = 'xkb:jp::jpn' if layout == 'jis' else 'xkb:us::eng'
        engines = list(dict.fromkeys(['anthy', base, *general.get_strv('preload-engines')]))
        previous = {}
        for settings, key, value in [
            (general, 'preload-engines', GLib.Variant('as', engines)),
            (general, 'engines-order', GLib.Variant('as', engines)),
            (general, 'use-system-keyboard-layout', GLib.Variant('b', True)),
            (hotkey, 'triggers', GLib.Variant('as', [])),
            (common, 'input-mode', GLib.Variant('i', 3)),  # direct Latin, not Hiragana
            (common, 'typing-method', GLib.Variant('i', 0)),  # romaji
            (common, 'shortcut-type', GLib.Variant('s', 'default')),
            (shortcut, 'default', GLib.Variant('a{sv}', {
                k: GLib.Variant('as', v) for k, v in anthy_shortcuts(shortcut.get_value('default').unpack()).items()
            })),
        ]:
            previous[settings.props.schema_id+'/'+key] = settings.get_value(key).print_(True)
            if not settings.set_value(key, value):
                raise RuntimeError('Could not save '+key)
        Gio.Settings.sync()
        # A new setup activates Anthy after its D-Bus service is ready. Later starts retain
        # user edits, including shortcuts and other engines selected in IBus settings.
        atomic_write(marker, json.dumps({'version': 1, 'previous': previous}, indent=2)+'\n')
        atomic_write(runtime/'activate-anthy', '1\n')
    configure_cjk(layout, preferred_engine(cmdline), runtime, fresh)
    print(f'keyboard-setup: physical={layout or "unchanged"} IMEs=Anthy,Pinyin,Hangul (Latin at first start)')


if __name__ == '__main__':
    main()
