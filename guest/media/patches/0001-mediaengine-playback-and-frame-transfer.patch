+static unsigned int media_engine_get_d3d11_format_size(DXGI_FORMAT format)
+{
+    switch (format)
+    {
+    case DXGI_FORMAT_B8G8R8A8_UNORM:
+    case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+    case DXGI_FORMAT_B8G8R8X8_UNORM:
+    case DXGI_FORMAT_B8G8R8X8_UNORM_SRGB:
+    case DXGI_FORMAT_R8G8B8A8_UNORM:
+    case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+        return 4;
+    default:
+        return 0;
+    }
+}
+
+static BOOL media_engine_valid_source_rect(const MFVideoNormalizedRect *rect)
+{
+    return !rect || (isfinite(rect->left) && isfinite(rect->top)
+            && isfinite(rect->right) && isfinite(rect->bottom)
+            && rect->left >= 0.0f && rect->top >= 0.0f
+            && rect->left < rect->right && rect->top < rect->bottom
+            && rect->right <= 1.0f && rect->bottom <= 1.0f);
+}
+
+static BOOL media_engine_valid_destination_rect(const RECT *rect, UINT width, UINT height)
+{
+    return width && height && width <= 0x7fffffff && height <= 0x7fffffff
+            && (!rect || (rect->left >= 0 && rect->top >= 0
+            && rect->left < rect->right && rect->top < rect->bottom
+            && (UINT)rect->right <= width && (UINT)rect->bottom <= height));
+}
+
+static HRESULT media_engine_get_transfer_box(UINT width, UINT height, const MFVideoNormalizedRect *src_rect,
+        const D3D11_TEXTURE2D_DESC *dst_desc, const RECT *dst_rect, D3D11_BOX *src_box)
+{
+    if (!width || !height || width > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION
+            || height > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION
+            || !media_engine_valid_source_rect(src_rect)
+            || !media_engine_valid_destination_rect(dst_rect, dst_desc->Width, dst_desc->Height))
+        return MF_E_UNEXPECTED;
+
+    src_box->left = src_rect ? src_rect->left * width : 0;
+    src_box->top = src_rect ? src_rect->top * height : 0;
+    src_box->right = src_rect ? src_rect->right * width : width;
+    src_box->bottom = src_rect ? src_rect->bottom * height : height;
+    src_box->front = 0;
+    src_box->back = 1;
+    if (src_box->left >= src_box->right || src_box->top >= src_box->bottom
+            || src_box->right > width || src_box->bottom > height
+            || src_box->right - src_box->left != (dst_rect ? (UINT)(dst_rect->right - dst_rect->left) : dst_desc->Width)
+            || src_box->bottom - src_box->top != (dst_rect ? (UINT)(dst_rect->bottom - dst_rect->top) : dst_desc->Height))
+        return MF_E_UNEXPECTED;
+    return S_OK;
+}
+
+static HRESULT media_engine_get_frame_data(BYTE *scanline, LONG pitch, BYTE *buffer_start, DWORD buffer_length,
+        UINT width, UINT height, UINT format_size, const D3D11_BOX *src_box, const BYTE **data)
+{
+    ULONG_PTR start = (ULONG_PTR)buffer_start, scan = (ULONG_PTR)scanline;
+    UINT64 scanline_offset, offset, end;
+
+    if (!scanline || !buffer_start || !buffer_length || pitch <= 0 || !format_size
+            || !width || !height || (UINT64)width * format_size > (UINT)pitch
+            || src_box->left >= src_box->right || src_box->top >= src_box->bottom
+            || src_box->right > width || src_box->bottom > height
+            || start > ~(ULONG_PTR)0 - buffer_length || scan < start || scan - start >= buffer_length)
+        return MF_E_UNEXPECTED;
+
+    scanline_offset = scan - start;
+    offset = (UINT64)src_box->top * pitch + (UINT64)src_box->left * format_size;
+    /* The final copied pixel must fit; padding after the last row is not required. */
+    end = scanline_offset + (UINT64)(src_box->bottom - 1) * pitch + (UINT64)src_box->right * format_size;
+    if (end > buffer_length)
+        return MF_E_UNEXPECTED;
+
+    *data = scanline + (SIZE_T)offset;
+    return S_OK;
+}
+
+static HRESULT media_engine_get_memory_frame_stride(struct media_engine *engine, UINT width, UINT height, LONG *pitch)
+{
+    IMFMediaTypeHandler *handler = NULL;
+    IMFStreamSink *stream = NULL;
+    IMFMediaType *type = NULL;
+    UINT32 stride, format;
+    UINT64 frame_size;
+    GUID subtype, expected;
+    HRESULT hr;
+
+    if (!engine->presentation.frame_sink)
+        return MF_E_UNEXPECTED;
+    if (FAILED(hr = video_frame_sink_query_iface(engine->presentation.frame_sink,
+            &IID_IMFStreamSink, (void **)&stream)))
+        goto done;
+    if (FAILED(hr = IMFStreamSink_GetMediaTypeHandler(stream, &handler)))
+        goto done;
+    if (FAILED(hr = IMFMediaTypeHandler_GetCurrentMediaType(handler, &type)))
+        goto done;
+    if (FAILED(hr = IMFMediaType_GetUINT64(type, &MF_MT_FRAME_SIZE, &frame_size)))
+        goto done;
+    if (FAILED(hr = IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &subtype)))
+        goto done;
+    if (FAILED(hr = IMFMediaType_GetUINT32(type, &MF_MT_DEFAULT_STRIDE, &stride)))
+        goto done;
+
+    memcpy(&expected, &MFVideoFormat_Base, sizeof(expected));
+    format = MFMapDXGIFormatToDX9Format(engine->video_frame.output_format);
+    expected.Data1 = format;
+    if (!format || !IsEqualGUID(&subtype, &expected) || (frame_size >> 32) != width
+            || (UINT32)frame_size != height || !stride || stride > 0x7fffffff
+            || (UINT64)width * media_engine_get_d3d11_format_size(engine->video_frame.output_format) > stride)
+        hr = MF_E_INVALIDMEDIATYPE;
+    else
+    {
+        *pitch = stride;
+        hr = S_OK;
+    }
+
+done:
+    if (type) IMFMediaType_Release(type);
+    if (handler) IMFMediaTypeHandler_Release(handler);
+    if (stream) IMFStreamSink_Release(stream);
+    return hr;
+}
