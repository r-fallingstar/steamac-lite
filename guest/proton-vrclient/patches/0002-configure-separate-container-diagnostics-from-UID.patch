Subject: [PATCH] configure: keep container diagnostics out of the UID probe

Podman may warn about its cgroup or event backend on stderr while successfully
running the container. Do not combine that diagnostic with the numeric UID.
Preserve stderr, reject command failures, and validate the numeric result before
the arithmetic comparisons. This does not change the user's container settings.

--- a/configure.sh
+++ b/configure.sh
@@ -57,12 +57,18 @@
     fi
 
     touch permission_check
-    local inner_uid="$($1 run -v "$(pwd):/test$CONTAINER_MOUNT_OPTS" \
+    local inner_uid
+    if ! inner_uid=$($1 run -v "$(pwd):/test$CONTAINER_MOUNT_OPTS" \
                                             --rm $2 \
-                                            stat --format "%u" /test/permission_check 2>&1)"
+                                            stat --format "%u" /test/permission_check); then
+        rm -f permission_check
+        die "Container UID probe failed. Check the container engine and, for rootless Podman, subuid/subgid mappings."
+    fi
     rm permission_check
 
-    if [[ $inner_uid == *"Permission denied"* ]]; then
+    if [[ ! $inner_uid =~ ^[0-9]+$ ]]; then
+        die "Container UID probe returned a non-numeric result: $inner_uid"
+    elif [[ $inner_uid == *"Permission denied"* ]]; then
         err "The container cannot access files. Are you using SELinux?"
         die "Please read README.md and check your $1 setup works."
     elif [[ $inner_uid == *"Emulate Docker CLI"* ]]; then
