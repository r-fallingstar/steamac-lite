#!/bin/bash
# Diagnostic clone only: no game, microphone or physical camera is opened.
set -u
exec 2>&1
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
steam=/home/steamos/.local/share/Steam
runtime="$steam/steamapps/common/SteamLinuxRuntime_4"
fex="$steam/steamapps/common/FEX-Emu"
proton="$steam/steamapps/common/Proton - Experimental"
root=/tmp/steamac-camera-rootfs
prefix=/home/steamos/.local/share/steamac-camera-dshow-test
echo CAMERA_TEST_BEGIN
python3 - <<'PY'
from pathlib import Path
import re
logs=Path('/home/steamos/.local/share/Steam/steamapps/compatdata/438100/pfx/drive_c/users/steamuser/AppData/LocalLow/VRChat/VRChat')
files=sorted(logs.glob('output_log_*.txt'),key=lambda p:p.stat().st_mtime,reverse=True)[:3]
for path in files:
    print('VRC_CAMERA_LOG_FILE '+path.name,flush=True)
    with path.open('rb') as f:
        f.seek(max(0,path.stat().st_size-5*1024*1024));text=f.read().decode(errors='replace')
    lines=[line for line in text.splitlines() if any(word in line.lower() for word in ['selfie','webcam','mediapipe','video capture','capturedevice','camera device'])]
    for line in lines[-80:]:
        line=re.sub(r'https?://\S+','[URL omitted]',line)
        line=re.sub(r'usr_[0-9a-f-]+','[user omitted]',line)
        print('VRC_CAMERA_LOG '+line[:1800],flush=True)
PY
for ((i=0;i<60;i++)); do [[ ! -f /run/steamac-camera-device ]] || break; sleep 1; done
device=$(cat /run/steamac-camera-device)
sleep 2
/usr/lib/steamac/camera/camera-agent --probe-read "$device"
native=$?
files=$(find "$runtime" -mindepth 2 -maxdepth 2 -type d -name files | head -1)
mkdir -p "$root/usr" "$prefix/fex-config" "$prefix/cache"
mount --bind "$files" "$root/usr"
mounted=$?
if ((mounted!=0)); then echo CAMERA_TEST_EXIT=1; systemctl poweroff; exit 1; fi
trap 'umount "$root/usr"' EXIT
mount -o remount,bind,ro "$root/usr"
for dir in bin etc; do ln -s "usr/$dir" "$root/$dir"; done
mkdir -p "$root/lib"
for arch in x86_64-linux-gnu i386-linux-gnu; do ln -s "../usr/lib/$arch" "$root/lib/$arch"; done
ln -s i386-linux-gnu/ld-linux.so.2 "$root/lib/ld-linux.so.2"
ln -s usr/lib/x86_64-linux-gnu "$root/lib64"
cp /usr/lib/steamac/camera/dshow-camera-test.exe "$prefix/dshow-camera-test.exe"
chown -R 1000:1000 "$prefix"
run_dshow() {
 local tool=$1 area=$2
 mkdir -p "$area/fex-config" "$area/cache"
 cp /usr/lib/steamac/camera/dshow-camera-test.exe "$area/dshow-camera-test.exe"
 chown -R 1000:1000 "$area"
 echo "CAMERA_DSHOW_TOOL $tool"
 setpriv --reuid=1000 --regid=1000 --init-groups env \
    HOME=/home/steamos USER=steamos LOGNAME=steamos XDG_RUNTIME_DIR=/run/user/1000 \
    FEX_ROOTFS="$root" FEX_PORTABLE=1 FEX_APP_CONFIG_LOCATION="$area/fex-config/" \
    XDG_CACHE_HOME="$area/cache" WINEPREFIX="$area/pfx" \
    WINEDEBUG=-all WINEDLLOVERRIDES=winemenubuilder.exe=d WINEESYNC=0 WINEFSYNC=0 \
    timeout 75s "$fex/usr/bin/FEX" "$tool/files/bin/wine" "$area/dshow-camera-test.exe" --fps=15
}
echo CAMERA_DSHOW_LAUNCH
run_dshow "$proton" "$prefix"
windows=$?
echo CAMERA_DSHOW_EXIT=$windows
comparison=0
archive=/usr/lib/steamac/camera/proton-rtsp-11.0-20260609-4.tar.gz
if [[ -f $archive ]]; then
 tools="$steam/compatibilitytools.d"
 expected=b52f231a116e9d0f1f9d19f4e870ff84392f35daae02391a6f79fdf9ca583415
 rtsp="$tools/proton-rtsp-11.0-20260609-4"
 if [[ $(sha256sum "$archive" | cut -d' ' -f1) != "$expected" ]]; then
  echo CAMERA_RTSP_ARCHIVE_INVALID; comparison=1
 elif [[ -e $rtsp && ! -f $rtsp/.steamac-camera-verified-source ]]; then
  echo CAMERA_RTSP_EXISTING_TOOL_NOT_REPLACED; comparison=1
 else
  if [[ ! -e $rtsp ]]; then
   mkdir -p "$tools"
   tar --no-same-owner -xzf "$archive" -C "$tools"
   printf '%s\n' "$expected" > "$rtsp/.steamac-camera-verified-source"
   chown -R 1000:1000 "$rtsp"
  fi
  run_dshow "$rtsp" "$prefix-rtsp"
  comparison=$?
  echo CAMERA_RTSP_DSHOW_EXIT=$comparison
 fi
fi
if ((native==0 && windows==0 && comparison==0)); then echo CAMERA_TEST_EXIT=0; else echo CAMERA_TEST_EXIT=1; fi
umount "$root/usr"
trap - EXIT
systemctl poweroff
