#!/bin/bash
set -euo pipefail
for ((i=0;i<60;i++)); do [[ ! -e /dev/virtio-ports/fx.camera ]] || break; sleep 1; done
[[ -e /dev/virtio-ports/fx.camera ]] || exit 0
# Wine's DirectShow enumerator scans only /dev/video0 through /dev/video9.
# Avoid any existing device, including an unrelated loopback module.
[[ ! -d /sys/module/v4l2loopback ]] || { echo 'camera: loopback module already owned by another service' >&2; exit 1; }
number=${STEAMAC_CAMERA_VIDEO_NR:-}
if [[ -z $number ]]; then
    for ((n=9;n>=0;n--)); do
        if [[ ! -e /dev/video$n && ! -e /sys/class/video4linux/video$n ]]; then number=$n; break; fi
    done
fi
[[ $number =~ ^[0-9]$ && ! -e /dev/video$number && ! -e /sys/class/video4linux/video$number ]] || { echo 'camera: no available Wine-compatible video number (0-9)' >&2; exit 1; }
device=/dev/video$number
insmod /usr/lib/steamac/camera/v4l2loopback.ko devices=1 video_nr="$number" 'card_label="steamac Built-in Camera Test"' exclusive_caps=1
for ((i=0;i<30;i++)); do [[ ! -e $device ]] || break; sleep .1; done
chown 1000:1000 "$device"
chmod 0600 "$device"
printf '%s\n' "$device" > /run/steamac-camera-device
exec /usr/lib/steamac/camera/camera-agent /dev/virtio-ports/fx.camera "$device"
