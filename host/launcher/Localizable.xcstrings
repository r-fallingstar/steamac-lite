    "Always included: app, macOS and library versions, Mac model, GPU, disk sizes and the launcher settings (never passwords or Keychain items).": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда включаются: версии приложения, macOS и библиотек, модель Mac, GPU, размеры дисков и настройки приложения (никогда — пароли или объекты связки ключей)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终包含：应用、macOS 和库版本、Mac 机型、GPU、磁盘大小和启动器设置（绝不含密码或钥匙串内容）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に含まれる情報：アプリ・macOS・ライブラリのバージョン、Macの機種、GPU、ディスク容量、ランチャー設定。パスワードやキーチェーンの項目は含みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 포함되는 항목: 앱, macOS 및 라이브러리 버전, Mac 모델, GPU, 디스크 크기 및 실행기 설정(암호 또는 키체인 항목은 절대 포함되지 않음)."
          }
        }
      }
    },
    "App %@": {
      "comment": "Game without a known name; Steam app ID",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение %@"
          }
        },
        "zh-Hans": {
