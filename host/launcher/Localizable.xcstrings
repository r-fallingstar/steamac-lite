    "%@: %@; SteamOS gets no wmtr channel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$@; SteamOS gets no wmtr channel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@; SteamOS не получит канал wmtr."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@；SteamOS 不会获得 wmtr 通道。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@。SteamOSのwmtrチャネルは無効です。"
