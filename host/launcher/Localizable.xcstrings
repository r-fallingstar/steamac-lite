    },
    "Camera access is not allowed. Check macOS Camera settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが許可されていません。macOSのカメラ設定を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접근이 허용되지 않았습니다. macOS 카메라 설정을 확인하세요."
          }
        },
        "zh-Hans": {
