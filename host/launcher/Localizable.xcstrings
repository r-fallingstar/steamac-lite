    "Vulkan driver applies on the next start of this game (VM restart required).": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Драйвер Vulkan сменится при следующем запуске игры (нужен перезапуск ВМ)."
          }
        },
        "zh-Hans": {
