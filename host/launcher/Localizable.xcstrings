    "Sharpening": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резкость"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锐化"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鮮明度"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선명도"
          }
        }
      }
    },
    "Sharpens the image while it is prepared for encoding; helps an upscaled or softly encoded picture. No measurable cost.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повышает резкость изображения при подготовке к кодированию; помогает масштабированной или мягко закодированной картинке. Затраты неизмеримо малы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在准备编码时锐化图像；有助于放大后或编码偏软的画面。无可测开销。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンコード前に映像を鮮明にします。拡大した映像や圧縮でぼやけた映像に有効です。測定できるほどの負荷増加はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인코딩 준비 중에 이미지를 선명하게 합니다. 업스케일되었거나 부드럽게 인코딩된 화면에 유용합니다. 눈에 띄는 부하 증가는 없습니다."
          }
        }
      }
    },
    "Short fade; the volume comes back when you switch back.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткое затухание; громкость восстанавливается при возвращении в приложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音量会短暂淡出；切回窗口时恢复。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短くフェードアウトします。アプリへ戻ると音量も元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧게 페이드아웃되며, 다시 전환하면 볼륨이 복원됩니다."
          }
        }
      }
    },
