            "state": "translated",
            "value": "이 게임 제거"
          }
        }
      }
    },
    "Frame latency": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержка кадра"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帧延迟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーム遅延"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임 지연 시간"
          }
        }
      }
    },
    "Frames sent": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлено кадров"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送帧"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信フレーム数"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송된 프레임"
          }
        }
      }
    },
    "Freezes the focused game (Steam, downloads and updates keep running). Online games may disconnect while paused.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставит активную игру на паузу (Steam, загрузки и обновления продолжают работать). Во время паузы в сетевых играх может прерваться соединение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冻结当前获得焦点的游戏（Steam、下载和更新会继续运行）。在线游戏在暂停期间可能断开连接。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作中のゲームを一時停止します。Steam・ダウンロード・更新は続行します。オンラインゲームは切断される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 게임을 일시 정지합니다(Steam, 다운로드 및 업데이트는 계속 실행됨). 일시 정지된 동안 온라인 게임 연결이 끊어질 수 있습니다."
          }
        }
      }
    },
    "Full HD, 16:9": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Full HD, 16:9"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全高清，16:9"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルHD、16:9"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Full HD, 16:9"
          }
        }
      }
    },
    "Full-window FX progress while SteamOS starts, restarts and shuts down. Off, or after a click: a small progress pill.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индикатор прогресса FX на всё окно при запуске, перезапуске и завершении работы SteamOS. Если отключён или после нажатия — небольшой компактный индикатор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamOS 启动、重启和关机时，在整个窗口显示 FX 进度界面。关闭此项或点按后，只显示一个小进度指示条。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamOSの起動・再起動・終了時に進行状況をウインドウ全体へ表示します。OFFの場合、またはクリック後は小さな進行表示に切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamOS가 시작, 재시작 및 종료되는 동안 전체 창에 FX 진행 상황을 표시합니다. 끄거나 클릭한 후에는 작은 진행 표시 막대가 나타납니다."
          }
        }
      }
    },
    "Further connected controllers are players 2 to 4 in SteamOS, each with a gamepad of its own, for local co-op. A player keeps their controller until it disconnects. Off: only one controller is used.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остальные подключённые контроллеры становятся игроками 2–4 в SteamOS, у каждого свой геймпад — для совместной игры на одном экране. Контроллер остаётся за игроком, пока не отключится. Выключено: используется только один контроллер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其余已连接的控制器在 SteamOS 中成为玩家 2 到 4，各有自己的手柄，用于本地合作。玩家的控制器在断开前保持不变。关闭：只使用一个控制器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加のコントローラーをSteamOSのプレイヤー2〜4として割り当て、ローカル協力プレイに使います。接続が切れるまで割り当てを保持します。OFFの場合は1台だけを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가로 연결된 컨트롤러는 로컬 협동 플레이를 위해 각각 고유한 게임패드를 가진 SteamOS의 플레이어 2~4가 됩니다. 플레이어는 연결이 끊어질 때까지 컨트롤러를 유지합니다. 끔: 하나의 컨트롤러만 사용됩니다."
          }
        }
      }
    },
    "GPU budget: %lld MiB. macOS and driver reserve: %lld MiB.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "GPU budget: %1$lld MiB. macOS and driver reserve: %2$lld MiB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
