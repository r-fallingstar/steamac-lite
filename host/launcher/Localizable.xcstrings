          }
        }
      }
    },
    "The app was copied successfully. Open it from Finder to continue.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのコピーは完了しています。Finderから開くと、初回設定へ進めます。"
          }
        },
        "ko": {
