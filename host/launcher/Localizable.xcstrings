        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲスト側の音量に加えて調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트 자체 볼륨에 더해 조절됩니다."
          }
        }
      }
    },
