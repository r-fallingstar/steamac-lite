    "Lower = less latency; Safe avoids crackling under load.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меньше — ниже задержка; «Надёжный» убирает треск под нагрузкой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "越低则延迟越小；“稳定”可避免高负载下的爆音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さい値ほど低遅延です。「安定」は高負荷時の音割れを抑えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮을수록 지연 시간이 줄어듭니다. '안정'은 부하 발생 시 잡음을 방지합니다."
          }
        }
      }
    },
    "Medium": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Среднее"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中"
          }
        },
