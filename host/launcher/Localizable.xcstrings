            "value": "強制終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강제 종료"
          }
        }
      }
    },
    "Forget this game": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыть эту игру"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
