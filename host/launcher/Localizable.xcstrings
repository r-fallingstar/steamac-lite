      }
    },
    "%@ already exists (never overwritten; delete it or choose another path)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже существует (файл никогда не перезаписывается; удалите его или выберите другой путь)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已存在（不会覆盖；请删除该文件或选择其他路径）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は既に存在します。上書きしないため、別の保存先を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 이미 존재합니다(덮어쓰지 않음. 삭제하거나 다른 경로를 선택하십시오)."
          }
        }
      }
    },
    "%@ game memory": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ памяти игры"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏内存 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームのメモリ使用量 %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 메모리 %@"
          }
        }
      }
    },
    "%@ is on a FAT32/MS-DOS volume, which cannot store files of 4 GiB or larger. The SteamOS disk and its 10 GiB rootfs exceed this limit: choose an APFS, Mac OS Extended, or exFAT volume": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ находится на томе FAT32/MS-DOS, который не поддерживает файлы размером 4 GiB и больше. Диск SteamOS и его rootfs размером 10 GiB превышают этот предел: выберите том APFS, Mac OS Extended или exFAT"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 位于 FAT32/MS-DOS 宗卷上，无法存储大小达到或超过 4 GiB 的文件。SteamOS 磁盘及其 10 GiB rootfs 均超出此限制：请选择 APFS、Mac OS Extended 或 exFAT 宗卷"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はFAT32/MS-DOS形式で、4 GiB以上のファイルを保存できません。SteamOSディスクと10 GiBのrootfsはこの上限を超えます。APFS、Mac OS拡張、またはexFAT形式を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 4 GiB 이상의 파일을 저장할 수 없는 FAT32/MS-DOS 볼륨에 있습니다. SteamOS 디스크와 10 GiB의 rootfs는 이 한도를 초과합니다. APFS, Mac OS 확장 또는 exFAT 볼륨을 선택하십시오."
          }
        }
      }
    },
    "%@ is on a read-only volume: choose a writable location for the SteamOS disk": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ находится на томе только для чтения: выберите место для диска SteamOS с доступом на запись"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 位于只读宗卷上：请为 SteamOS 磁盘选择可写入的位置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は読み取り専用です。SteamOSディスクを書き込める場所を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 읽기 전용 볼륨에 있습니다. SteamOS 디스크를 쓸 수 있는 위치를 선택하십시오."
          }
        }
      }
    },
