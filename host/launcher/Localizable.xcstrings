    "%@ GB free there; about 14 GB are needed (the disk is sparse) plus ~6 GB of download cache.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь свободно %@ ГБ; потребуется около 14 ГБ (образ диска разреженный) и ещё ~6 ГБ для кэша загрузки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该位置有 %@ GB 可用空间；约需 14 GB（磁盘为稀疏文件），另需约 6 GB 下载缓存空间。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量は%@ GBです。ディスク用に約14 GB（スパース形式）、ダウンロードキャッシュ用に約6 GBが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 위치의 여유 공간은 %@ GB입니다. 디스크에 약 14 GB(스파스 형식)와 다운로드 캐시에 약 6 GB가 필요합니다."
          }
        }
      }
    },
    "%@ MB · %@ MB/s": {
      "localizations": {
        "en": {
