          }
        }
      }
    },
    "At least 512 MB of free space is needed to install the app.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのインストールには、512 MB以上の空き容量が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 설치하려면 여유 공간이 512 MB 이상 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装应用需要至少 512 MB 可用空间。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для установки приложения требуется не менее 512 МБ свободного места."
          }
        }
      }
    },
    "Check the free space and write permission for Applications. You can also drag the app into Applications in Finder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量とアプリケーションフォルダへの書き込み権限を確認してください。Finderでアプリをアプリケーションへドラッグして入れることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여유 공간과 응용 프로그램 폴더의 쓰기 권한을 확인하세요. Finder에서 앱을 응용 프로그램 폴더로 드래그해 설치할 수도 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查可用空间和“应用程序”文件夹的写入权限。也可以在 Finder 中将应用拖入“应用程序”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте свободное место и право записи в папку «Программы». Также можно перетащить приложение в эту папку через Finder."
          }
        }
      }
    },
