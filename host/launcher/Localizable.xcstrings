    "not enough free space for the download cache: %@ GB needed in %@, %@ GB free": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "not enough free space for the download cache: %1$@ GB needed in %2$@, %3$@ GB free"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "недостаточно места для кэша загрузки: требуется %@ ГБ в %@, свободно %@ ГБ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载缓存空间不足：%2$@ 中需要 %1$@ GB，可用空间为 %3$@ GB"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードキャッシュの空き容量が不足しています。保存先「%2$@」には%1$@ GB必要ですが、空き容量は%3$@ GBです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 캐시의 여유 공간 부족: %2$@에 %1$@ GB가 필요하지만 %3$@ GB만 남아 있습니다"
          }
        }
      }
    },
    "not enough free space on exFAT: %@ GB needed on %@, %@ GB free. exFAT stores the full disk size (no sparse files); choose a smaller home size or an APFS volume": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "not enough free space on exFAT: %1$@ GB needed on %2$@, %3$@ GB free. exFAT stores the full disk size (no sparse files); choose a smaller home size or an APFS volume"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "недостаточно места на exFAT: требуется %@ ГБ на %@, свободно %@ ГБ. exFAT хранит диск в полном размере (без разреженных файлов); выберите меньший объём home или том APFS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "exFAT 上的可用空间不足：%2$@ 上需要 %1$@ GB，可用空间为 %3$@ GB。exFAT 会存储完整磁盘大小（不支持稀疏文件）；请选择更小的 home 分区容量或 APFS 宗卷"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "exFATの空き容量が不足しています。%@ GBが必要な保存先%@に、%@ GBの空きしかありません。exFATはディスク全体の容量を使います。home容量を小さくするかAPFSを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "exFAT의 여유 공간 부족: %2$@에 %1$@ GB가 필요하지만 %3$@ GB만 남아 있습니다. exFAT는 전체 디스크 크기를 저장하므로(스파스 파일 미지원), 더 작은 home 크기를 선택하거나 APFS 볼륨을 선택하십시오"
          }
        }
      }
    },
    "not enough free space: %@ GB needed on the volume of %@, %@ GB free": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "not enough free space: %1$@ GB needed on the volume of %2$@, %3$@ GB free"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "недостаточно свободного места: требуется %@ ГБ на томе %@, свободно %@ ГБ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空间不足：%2$@ 所在宗卷需要 %1$@ GB，可用空间为 %3$@ GB"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量が不足しています。「%2$@」のボリュームには%1$@ GB必要ですが、空き容量は%3$@ GBです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여유 공간 부족: %2$@ 볼륨에 %1$@ GB가 필요하지만 %3$@ GB만 남아 있습니다"
          }
        }
      }
