            "value": "应用 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 %@"
          }
        }
      }
    },
    "App ID %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ID приложения %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
