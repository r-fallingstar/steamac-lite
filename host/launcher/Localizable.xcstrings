{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "\"Still working\" card over the picture after 2 s without GPU work from SteamOS (loading, shader compiles).": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карточка «Работа продолжается» поверх изображения после 2 с без активности GPU в SteamOS (загрузка, компиляция шейдеров)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamOS 连续 2 秒没有 GPU 活动时（加载或编译着色器），在画面上显示“仍在工作”提示卡片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamOSから2秒間GPU処理がないとき（ロード中やシェーダーのコンパイル中）に、画面へ「処理中」を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamOS에서 2초 동안 GPU 작업이 없을 때(로딩 또는 셰이더 컴파일 중) 화면에 '처리 중' 카드를 표시합니다."
          }
        }
      }
    },
    "%@ %lld%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$lld%%"
          }
