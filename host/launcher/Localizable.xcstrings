    "Open Camera privacy settings…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの許可設定を開く…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 권한 설정 열기…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
