     pub fn output_device(&self) -> Option<String> {
         self.output_device.lock().unwrap().clone()
+    }
+
+    pub fn set_input_device(&self, uid: Option<String>) {
+        *self.input_device.lock().unwrap() = uid;
+        // Reapplying the same UID can recover capture after permission was granted.
+        self.input_generation.fetch_add(1, Ordering::Release);
+        self.changed();
+    }
+
+    pub fn input_device(&self) -> Option<String> {
+        self.input_device.lock().unwrap().clone()
+    }
+
+    pub fn input_generation(&self) -> u64 {
+        self.input_generation.load(Ordering::Acquire)
     }
 
     /// `gain` must be within 0..=1.
