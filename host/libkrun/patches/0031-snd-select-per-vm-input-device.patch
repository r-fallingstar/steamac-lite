+    #[test]
+    fn input_route_prefers_selected_microphone_and_recovers_after_reconnect() {
+        assert_eq!(select_input_route(Some("usb"), |_| Some(7), || panic!("default must not be used")), Some(7));
+        assert_eq!(select_input_route(None, |_| panic!("no UID to resolve"), || Some(2)), Some(2));
+        assert_eq!(select_input_route(Some("usb"), |_| None, || Some(2)), Some(2));
+        assert_eq!(select_input_route(Some("usb"), |_| None, || None), None);
+        assert_eq!(select_input_route(Some("usb"), |_| Some(8), || Some(2)), Some(8));
