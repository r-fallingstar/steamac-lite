+
+    #[test]
+    fn input_selection_wakes_capture_without_changing_output() {
+        let control = SndControl::default();
+        control.set_output_device(Some("speaker".into()));
+        let generation = control.input_generation();
+        control.set_input_device(Some("mic".into()));
+        assert_eq!(control.input_device().as_deref(), Some("mic"));
+        assert!(control.input_generation() > generation);
+        let generation = control.input_generation();
+        control.set_input_device(Some("mic".into()));
+        assert!(control.input_generation() > generation, "same UID can retry a denied capture");
+        control.set_input_device(None);
+        assert_eq!(control.input_device(), None);
+        assert_eq!(control.output_device().as_deref(), Some("speaker"));
+    }
