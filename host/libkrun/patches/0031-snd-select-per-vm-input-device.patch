+/// Per-VM input route. A missing saved UID falls back to the system default until reconnect.
+#[allow(clippy::missing_safety_doc)]
+#[no_mangle]
+pub unsafe extern "C" fn krun_snd_set_input_device(ctx_id: u32, uid: *const c_char) -> i32 {
+    #[cfg(all(feature = "snd", target_os = "macos"))]
+    {
+        let uid = if uid.is_null() { None } else {
+            match CStr::from_ptr(uid).to_str() {
+                Ok("") => None,
+                Ok(value) => Some(value.to_owned()),
+                Err(_) => return -libc::EINVAL,
+            }
+        };
+        with_snd_control(ctx_id, |control| { control.set_input_device(uid); KRUN_SUCCESS })
+    }
+    #[cfg(not(all(feature = "snd", target_os = "macos")))]
+    { let _ = (ctx_id, uid); -libc::ENOTSUP }
+}
