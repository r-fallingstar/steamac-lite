From: SteamAC Lite <steamac-lite@local>
Subject: [PATCH 29] snd: initialize capture buffers and wait for microphone readiness

The asynchronous capture path never initialized Shared's callback frame size
or channel count. HAL input is interleaved Float32, but render_input advertised
the default 4-byte frame with two channels. AudioUnitRender rejected the buffer
and the input ring stayed empty, despite receiving microphone callbacks.

Initialize the callback metadata from the HAL stream format before starting it.
Also hold queued capture periods until PCM_START and the HAL unit is ready:
unpaced synthetic silence previously advanced hw_ptr and triggered XRUNs.
Failed microphone startup completes pending I/O with IO_ERR. Regression coverage
exercises PREPARE, pending startup, and failed startup without physical recording.

--- a/src/devices/src/virtio/snd/audio_backends/coreaudio.rs
+++ b/src/devices/src/virtio/snd/audio_backends/coreaudio.rs
@@ -1640,6 +1640,12 @@
         // The HAL unit does not resample input: take Float32 at the device rate and convert in
         // the pump thread.
         let dev_fmt = float_asbd(rate, fmt.channels);
+        // render_input must describe the HAL buffer in device Float32 frames, not
+        // the guest S16 layout or Shared's stereo defaults. The prior unit is
+        // stopped above, so no callback races these updates before start().
+        shared.frame_bytes.store(dev_fmt.mBytesPerFrame, Ordering::Relaxed);
+        shared.channels.store(dev_fmt.mChannelsPerFrame, Ordering::Relaxed);
+        shared.rate.store(rate as u32, Ordering::Relaxed);
         unit.set(
             kAudioUnitProperty_StreamFormat,
             kAudioUnitScope_Output,
@@ -2593,6 +2599,21 @@
         };
         let mut streams = streams.write().unwrap();
         let guest = &mut streams[self.id];
+        // ALSA queues capture periods at PREPARE, before PCM_START. Completing them
+        // early advances hw_ptr without a recording clock and causes immediate XRUNs.
+        if guest.state != PCMState::Start || self.control.paused() {
+            return;
+        }
+        if state.is_none() && self.vr_mic.is_none() {
+            if !self.shared.starting.load(Ordering::Acquire) && !self.suspended {
+                // A failed microphone start is an I/O error, not unlimited silence.
+                for buf in guest.buffers.drain(..) {
+                    buf.message.status.store(VIRTIO_SND_S_IO_ERR, Ordering::SeqCst);
+                    buf.message.latency_bytes.store(0, Ordering::Relaxed);
+                }
+            }
+            return;
+        }
         let fb = fmt.frame_bytes() as usize;
         let channels = fmt.channels;
         let mut out = Vec::new();
@@ -2667,9 +2688,7 @@
                         }
                         packets as usize * fb
                     }
-                    // The microphone is not up: complete the guest's buffers with silence so
-                    // its capture stream keeps flowing instead of timing out.
-                    None => space,
+                    None => 0, // waiting for the asynchronous microphone start
                 };
                 if produced == 0 {
