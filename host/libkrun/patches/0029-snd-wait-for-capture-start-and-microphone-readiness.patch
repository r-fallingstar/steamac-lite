+    /// Capture periods are queued before START and must wait for the physical
+    /// microphone. Previously they completed as fast as the guest could queue them.
+    #[test]
+    fn capture_waits_for_start_and_microphone_readiness() {
+        let wake = Arc::new(Semaphore::new().unwrap());
+        let mut host = HostStream::new(0, Direction::Input, wake, Arc::new(SndControl::default()));
+        host.guest_format = Some(Format {
+            format: VIRTIO_SND_PCM_FMT_S16, rate: 48000, channels: 1,
+        });
+        let mut stream = Stream::default();
+        stream.direction = Direction::Input;
+        stream.state = PCMState::Prepare;
+        let mem = GuestMemoryMmap::<()>::from_ranges(&[(GuestAddress(0), 0x1000)]).unwrap();
+        let interrupt = InterruptTransport::new(DummyIrqChip::new().into(), "snd-capture-test".into()).unwrap();
+        let message = Arc::new(IOMessage {
+            status: AtomicU32::new(VIRTIO_SND_S_OK), used_len: 0.into(),
+            latency_bytes: 0.into(), head_index: 0,
+            response_descriptor: Descriptor { addr: 0x100, len: 8, flags: 0, next: 0 },
+            vring: Arc::new(Mutex::new(Vring { mem, queue: Queue::new(16), interrupt })),
+        });
+        stream.buffers.push_back(Buffer::new(
+            Descriptor { addr: 0x200, len: 960, flags: 0, next: 0 },
+            message.clone(), Direction::Input,
+        ));
+        let streams = RwLock::new(vec![stream]);
+        let mut capture = None;
+        host.pump_input(&mut capture, &streams);
+        assert!(!completed(&message), "PREPARE cannot advance the capture clock");
+        assert_eq!(streams.read().unwrap()[0].buffers[0].pos, 0);
+        streams.write().unwrap()[0].state = PCMState::Start;
+        host.shared.running.store(true, Ordering::Release);
+        host.shared.starting.store(true, Ordering::Release);
+        for _ in 0..100 {
+            host.pump_input(&mut capture, &streams);
+        }
+        assert!(!completed(&message), "pending microphone startup must not emit silence");
+        assert_eq!(streams.read().unwrap()[0].buffers[0].pos, 0);
+        host.shared.starting.store(false, Ordering::Release);
+        host.shared.running.store(false, Ordering::Release);
+        host.pump_input(&mut capture, &streams);
+        assert!(completed(&message), "failed start releases queued guest I/O");
+        assert_eq!(message.status.load(Ordering::SeqCst), VIRTIO_SND_S_IO_ERR);
+    }
+
     /// Holds `hosts` like a pump stuck in an AudioUnit call, until dropped.
     struct StuckPump {
         release: Option<mpsc::Sender<()>>,
